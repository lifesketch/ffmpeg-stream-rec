# Копируй в .env и правь при необходимости
#
# Docker Compose: порт на хосте, если занят 8080 (внутри контейнера всегда 5000)
# HOST_PORT=8080
SECRET_KEY=замени-на-случайную-строку
RECORDINGS_ROOT=recordings
STATE_DB_PATH=data/state.sqlite3
LOG_DIR=logs
MAX_INDEPENDENT_SESSIONS=2
MAX_CONTINUATIONS=5
# Базовое имя MP4 в форме и при пустом поле: steam1 → steam1_001.mp4, …
DEFAULT_RECORDING_BASENAME=steam1
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Если задан — нужен заголовок Authorization: Bearer <токен>
# RECORDING_AUTH_TOKEN=
# При SIGTERM/Ctrl+C и выходе процесса — мягкая остановка FFmpeg (0/false — отключить)
# RECORDING_SHUTDOWN_HOOKS=1
# Макс. секунд ожидания завершения сессий перед выходом процесса
# RECORDING_SHUTDOWN_WAIT_SEC=90
